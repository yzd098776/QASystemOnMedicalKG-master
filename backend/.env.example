# 复制为 .env 并填入真实值
# 注意：以下配置均为启动必填项，缺失或为弱值时后端将拒绝启动

# DeepSeek 大模型 API 密钥（未配置时 AI 问答使用降级模拟响应）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Neo4j 数据库连接（未配置密码时拒绝启动）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# JWT 签名密钥（必填，长度 >=32，禁止 change-me/secret/123456/password 等弱值）
# 生成强随机值：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=此处替换为上面命令生成的强随机值

# 令牌有效期：access token（分钟）/ refresh token（天）
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 限流阈值（每分钟请求数）：登录与注册接口 / AI 问答接口
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20

# 健康档案敏感字段加密密钥（Fernet；未配置时敏感字段以明文存储并告警）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=此处替换为上面命令生成的Fernet密钥
