# 复制为 .env 并填入真实值
# 注意：以下配置均为启动必填项，缺失或为弱值时后端将拒绝启动

# DeepSeek 大模型 API 密钥（未配置时 AI 问答使用降级模拟响应）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Neo4j 数据库连接（未配置密码时拒绝启动）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# JWT 签名密钥（必填，长度 >=32，禁止 change-me/secret/123456/password 等弱值）
# 生成强随机值：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=此处替换为上面命令生成的强随机值

# 令牌有效期：access token（分钟）/ refresh token（天）
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 限流阈值（每分钟请求数）：登录与注册接口 / AI 问答接口
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20

# 健康档案敏感字段加密密钥（Fernet；未配置时敏感字段以明文存储并告警）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=此处替换为上面命令生成的Fernet密钥

# ========== GraphRAG 问答管线（阶段三，均有合理默认值，可按需调整） ==========
# 混合检索权重：关键词召回（别名+CONTAINS）与向量召回（余弦相似）的加权融合，
# 两者之和建议为 1.0（不强制；数值越大该路得分占比越高）
HYBRID_KEYWORD_WEIGHT=0.6
HYBRID_VECTOR_WEIGHT=0.4

# 嵌入维度：纯 Python 哈希字符 n-gram 嵌入维度，
# 修改后必须重建向量索引（重跑 backend/scripts/build_vector_index.py）
EMBEDDING_DIM=256

# 向量索引名前缀：实际索引名为 {前缀}_{标签小写}，如 kg_embedding_disease
VECTOR_INDEX_PREFIX=kg_embedding

# Text2Cypher 长尾补位开关（仅在配置了 DEEPSEEK_API_KEY 且检索结果不足时触发；
# 生成的 Cypher 经白名单校验后以只读超时事务执行，校验/执行失败自动降级）
TEXT2CYPHER_ENABLED=true
# Text2Cypher 只读事务超时（秒）
TEXT2CYPHER_TIMEOUT=10

# ========== 用户数据存储后端（阶段 A：MySQL 迁移，可回滚） ==========
# json：五处 JSON 文件存储（默认，回滚路径）；sql：MySQL 8 存储。
# 改这一个变量即可在两后端间切换/回退，/api 契约两者完全一致。
STORE_BACKEND=json
# MySQL 连接参数（仅 STORE_BACKEND=sql 时必填并强校验）。
# 地址不写死：后端跑 WSL 宿主机（docker 外）时用 127.0.0.1；
# 后端进容器（compose）时容器内互访改用服务名，如 MYSQL_HOST=mysql。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 专用账号（非 root），只授业务库增删改查
MYSQL_USER=kguser
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=medicalkg

# ========== 语义嵌入升级（阶段 B，均可选；未配置即整体降级为哈希嵌入） ==========
# 嵌入提供方：hash（默认，纯 Python 哈希 n-gram，零外部调用）| zhipu | tongyi | qwen（专属部署）
EMBEDDING_PROVIDER=hash
# 智谱 embedding-3（batch 64）；仅 EMBEDDING_PROVIDER=zhipu 时需要
ZHIPU_API_KEY=
# 通义 text-embedding-v3 / 千问专属部署（batch 10）；tongyi/qwen 时复用此项作 api key
DASHSCOPE_API_KEY=
# 千问专属部署（EMBEDDING_PROVIDER=qwen）：完整 embeddings 端点 + 模型名 + 批次
# 例：https://<专属实例>.maas.aliyuncs.com/compatible-mode/v1/embeddings（容器内外同值，走公网）
EMBED_API_BASE_URL=
EMBEDDING_MODEL=
EMBED_BATCH_SIZE=10
# 嵌入模型版本标识（入 MySQL entity_embeddings 主键，换模型时天然并存）
EMBEDDING_MODEL_VER=
# 语义嵌入维度（建议 512；provider=hash 时沿用上方 EMBEDDING_DIM）
SEMANTIC_EMBEDDING_DIM=512
# 查询嵌入缓存 TTL（秒）与远程调用超时（秒，超时即降级哈希嵌入）
EMBED_CACHE_TTL=60
EMBED_TIMEOUT_SECONDS=2
# 连续失败熔断：N 次失败后暂停远程调用 M 秒（期间自动走哈希兜底）
EMBED_CIRCUIT_FAILURES=3
EMBED_CIRCUIT_COOLDOWN=60
# 建索引 dry-run 费用熔断阈值（元）：预估超过该值时脚本中止并提示
EMBEDDING_MAX_COST_YUAN=10
# 各 provider 每千条单价（元，用于 dry-run 预估），默认值见 core/config.py
EMBED_COST_PER_1K_ZHIPU=0.0005
EMBED_COST_PER_1K_TONGYI=0.0007

# ========== 缓存与性能（阶段四） ==========
# Redis 连接串（可选）：留空则缓存走进程内 LRU（默认单 worker 部署）；
# 配置后多 worker/多实例共享缓存，需安装可选依赖 pip install "redis[hiredis]"
# REDIS_URL=redis://localhost:6379/0
# 本地 LRU 容量上限（超出淘汰最久未使用项）
CACHE_MAX_ENTRIES=1024
# 缓存默认存活时间（秒）
CACHE_DEFAULT_TTL=300
# 实体详情缓存存活时间（秒）：图谱只读，短 TTL 兼顾新鲜度与命中率
ENTITY_CACHE_TTL=300
# 慢查询日志阈值（毫秒）：Cypher 执行耗时超过该值记 WARNING
SLOW_QUERY_MS=200

